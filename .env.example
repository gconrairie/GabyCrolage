# Fichier .env (non versionné) — dev local, build Docker et run Docker.
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_COLLECT_SECRET=
IG_STORY_STATS_FILE=.data/instagram-story-stats.json

# --- Docker / Docker Compose (+ Nginx Proxy Manager) ---
# Fichier .env à la racine : Compose s’en sert pour injecter les variables IG_* au *run*.
#   docker compose build --no-cache && docker compose up -d
#
# NPM : Forward → http://gabycrolage-web:8080 (schéma http, pas https).
# Réseau partagé : npm-graab.
# Cron VPS collecte stories :
#   0 0 * * * curl -fsS "https://gabycrolage.com/api/instagram?action=collect-stories&secret=$IG_COLLECT_SECRET" >/dev/null
#
# Sans Compose : docker build -t gabycrolage:latest .
